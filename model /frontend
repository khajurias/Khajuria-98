class APIError(Exception):
    def __init__(self, message, status_code=None):
        super().__init__(message)
        self.status_code = status_code


def api_request(method, path, token=None, payload=None, params=None):
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    try:
        response = requests.request(
            method,
            f"{API_URL}{path}",
            headers=headers,
            json=payload,
            params=params,
            timeout=300 if path == "/predict" else 15,
        )
    except requests.Timeout as error:
        message = (
            "The analysis took too long. If this is the first analysis, the model may "
            "still be training; wait a moment and try again."
            if path == "/predict"
            else "InnerEcho did not respond in time. Please try again."
        )
        raise APIError(
            message
        ) from error
    except requests.RequestException as error:
        raise APIError(
            "I can't reach the InnerEcho service right now. Check that the backend is running."
        ) from error
    try:
        data = response.json()
    except ValueError:
        data = {}
    if not response.ok:
        raise APIError(str(data.get("detail", "That didn't work. Please try again.")), response.status_code)
    return data


@st.cache_resource(show_spinner=False)
def load_speech_model():
    from faster_whisper import WhisperModel

    return WhisperModel("tiny", device="cpu", compute_type="int8")


def transcribe_audio(audio_bytes):
    model = load_speech_model()
    segments, _ = model.transcribe(
        io.BytesIO(audio_bytes),
        beam_size=3,
        vad_filter=True,
    )
    return " ".join(segment.text.strip() for segment in segments).strip()


