def valid_source_url(value):
    if not value.strip():
        return True
    parsed = urlparse(value.strip())
    return parsed.scheme in {"http", "https"} and bool(parsed.netloc)


def collect_review_text(url, limit=30):
    response = requests.get(
        url,
        headers={"User-Agent": "InnerEcho Review Collector/1.0"},
        timeout=20,
    )
    response.raise_for_status()

    soup = BeautifulSoup(response.text, "html.parser")
    for unwanted in soup.select("script, style, nav, header, footer, aside, form, svg"):
        unwanted.decompose()
    candidates = []

    for script in soup.select("script[type='application/ld+json']"):
        try:
            import json
            data = json.loads(script.get_text(strip=True))
        except (json.JSONDecodeError, TypeError):
            continue
        objects = data if isinstance(data, list) else [data]
        for item in objects:
            if not isinstance(item, dict):
                continue
            nested = item.get("@graph", []) if isinstance(item.get("@graph"), list) else []
            objects_to_check = [item] + nested
            for candidate in objects_to_check:
                review_body = candidate.get("reviewBody") if isinstance(candidate, dict) else None
                if isinstance(review_body, dict):
                    review_body = review_body.get("@value") or review_body.get("text")
                if isinstance(review_body, str):
                    candidates.append(review_body.strip())

    for node in soup.select('[itemprop="reviewBody"], .review-text, .reviewText, .comment-text, .testimonial-text'):
        text = node.get_text(" ", strip=True)
        if text:
            candidates.append(text)

    if not candidates:
        for node in soup.select("[class*='review'], [class*='comment'], [class*='testimonial']"):
            text = node.get_text(" ", strip=True)
            if text:
                candidates.append(text)

    if not candidates:
        for node in soup.select("article p, main p, [role='main'] p"):
            text = node.get_text(" ", strip=True)
            if len(text) >= 35:
                candidates.append(text)

    unique = []
    seen = set()
    for text in candidates:
        normalized = " ".join(text.split())
        key = normalized.lower()
        if len(normalized) >= 20 and key not in seen:
            seen.add(key)
            unique.append(normalized[:5000])
        if len(unique) >= limit:
            break
    return unique


