@app.post("/profiles/create")
def create_profile(payload: ProfileCreate):
    display_name = re.sub(r"\s+", " ", (payload.display_name or payload.username)).strip()
    if not re.fullmatch(r"[\w .'-]{1,32}", display_name, flags=re.UNICODE):
        raise HTTPException(
            status_code=422,
            detail="Use a name up to 32 characters with letters, spaces, apostrophes, dots, or dashes.",
        )
    username = display_name.casefold()
    if payload.date_of_birth and payload.date_of_birth >= today_utc():
        raise HTTPException(status_code=422, detail="Date of birth must be in the past.")
    salt = secrets.token_bytes(16).hex()
    password = secrets.token_urlsafe(32)
    pin_digest = hash_pin(payload.pin, salt)
    try:
        with database() as connection:
            cursor = connection.execute(
                """INSERT INTO users(username, password_hash, salt, created_at, display_name,
                   date_of_birth, profile_pin_hash) VALUES (?, ?, ?, ?, ?, ?, ?)""",
                (
                    username,
                    hash_password(password, salt),
                    salt,
                    now_text(),
                    display_name,
                    payload.date_of_birth.isoformat() if payload.date_of_birth else None,
                    pin_digest,
                ),
            )
            row = connection.execute(
                "SELECT * FROM users WHERE id = ?", (cursor.lastrowid,)
            ).fetchone()
    except sqlite3.IntegrityError as error:
        raise HTTPException(status_code=409, detail="That profile name is already in use.") from error
    return issue_auth_for_row(row)


@app.post("/profiles/open")
def open_profile(payload: ProfileOpen):
    with database() as connection:
        row = connection.execute(
            "SELECT * FROM users WHERE username = ?",
            (re.sub(r"\s+", " ", payload.username).strip().casefold(),),
        ).fetchone()
    if (
        row is None
        or not row["profile_pin_hash"]
        or not hmac.compare_digest(hash_pin(payload.pin, row["salt"]), row["profile_pin_hash"])
    ):
        raise HTTPException(status_code=401, detail="Profile name or PIN is incorrect.")
    return issue_auth_for_row(row)


@app.post("/auth/register")
def register(payload: Credentials):
    username = payload.username.strip().lower()
    if not re.fullmatch(r"[a-z0-9_.-]{3,32}", username):
        raise HTTPException(
            status_code=422,
            detail="Use 3-32 letters, numbers, dots, dashes, or underscores.",
        )
    salt = secrets.token_bytes(16).hex()
    try:
        with database() as connection:
            cursor = connection.execute(
                """INSERT INTO users(username, password_hash, salt, created_at, display_name)
                VALUES (?, ?, ?, ?, ?)""",
                (username, hash_password(payload.password, salt), salt, now_text(), username),
            )
            row = connection.execute(
                "SELECT * FROM users WHERE id = ?", (cursor.lastrowid,)
            ).fetchone()
    except sqlite3.IntegrityError as error:
        raise HTTPException(status_code=409, detail="That username is already in use.") from error
    return issue_auth_for_row(row)


@app.post("/auth/login")
def login(payload: Credentials):
    with database() as connection:
        row = connection.execute(
            "SELECT * FROM users WHERE username = ?", (payload.username.strip().lower(),)
        ).fetchone()
    if row is None or not hmac.compare_digest(
        hash_password(payload.password, row["salt"]), row["password_hash"]
    ):
        raise HTTPException(status_code=401, detail="Username or password is incorrect.")
    return issue_auth_for_row(row)


