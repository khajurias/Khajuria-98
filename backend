@app.post("/game/daily-emoji")
def submit_daily_emoji(payload: DailyEmojiSubmission, user: User):
    if payload.mood not in EMOTIONS:
        raise HTTPException(status_code=422, detail="Choose a listed emotion.")
    today = today_utc().isoformat()
    goal = daily_goal(user["id"])
    reward = 10 if payload.mood == goal else 0
    try:
        with database() as connection:
            connection.execute(
                """INSERT INTO daily_emoji_tasks
                (user_id, task_date, mood, eyes, mouth, accessory, face_color, reward, created_at)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                (
                    user["id"], today, payload.mood, payload.eyes, payload.mouth,
                    payload.accessory, payload.face_color, reward, now_text(),
                ),
            )
            if reward:
                connection.execute(
                    "INSERT OR IGNORE INTO game_scores(user_id) VALUES (?)",
                    (user["id"],),
                )
                connection.execute(
                    "UPDATE game_scores SET score = score + ? WHERE user_id = ?",
                    (reward, user["id"]),
                )
    except sqlite3.IntegrityError as error:
        raise HTTPException(status_code=409, detail="Today's emoji mission is already complete.") from error
    return {"date": today, "goal": goal, "reward": reward, "completed": True}


