@app.post("/predict")
def analyze(payload: PredictionRequest, user: User):
    text = payload.text.strip()
    if not text:
        raise HTTPException(status_code=422, detail="Enter text to analyze.")
    source_url = payload.source_url.strip()
    duplicate_cutoff = (utc_now() - timedelta(seconds=10)).strftime(
        "%Y-%m-%d %H:%M:%S"
    )
    with database() as connection:
        existing = connection.execute(
            """SELECT text, emotion, scores_json, source_url
            FROM predictions
            WHERE user_id = ? AND text = ? AND source_url = ? AND created_at >= ?
            ORDER BY id DESC LIMIT 1""",
            (user["id"], text, source_url, duplicate_cutoff),
        ).fetchone()
    if existing is not None:
        return {
            "text": existing["text"],
            "emotion": existing["emotion"],
            "scores": json.loads(existing["scores_json"]),
            "source_url": existing["source_url"],
        }

    emotion, scores = predict_emotion(text)
    with database() as connection:
        connection.execute("BEGIN IMMEDIATE")
        duplicate_cutoff = (utc_now() - timedelta(seconds=10)).strftime(
            "%Y-%m-%d %H:%M:%S"
        )
        existing = connection.execute(
            """SELECT text, emotion, scores_json, source_url
            FROM predictions
            WHERE user_id = ? AND text = ? AND source_url = ? AND created_at >= ?
            ORDER BY id DESC LIMIT 1""",
            (user["id"], text, source_url, duplicate_cutoff),
        ).fetchone()
        if existing is not None:
            return {
                "text": existing["text"],
                "emotion": existing["emotion"],
                "scores": json.loads(existing["scores_json"]),
                "source_url": existing["source_url"],
            }
        connection.execute(
            """INSERT INTO predictions(created_at, text, emotion, scores_json, user_id, source_url)
            VALUES (?, ?, ?, ?, ?, ?)""",
            (now_text(), text, emotion, json.dumps(scores), user["id"], source_url),
        )
    return {"text": text, "emotion": emotion, "scores": scores, "source_url": source_url}


