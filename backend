@app.get("/insights/trends")
def trends(user: User, days: int = 30):
    if not 1 <= days <= 365:
        raise HTTPException(status_code=422, detail="Days must be between 1 and 365.")
    start_date = (today_utc() - timedelta(days=days - 1)).isoformat()
    with database() as connection:
        rows = connection.execute(
            """SELECT day, emotion, COUNT(*) AS count
            FROM (
                SELECT DISTINCT substr(created_at, 1, 10) AS day, emotion,
                    created_at, text, scores_json, source_url
                FROM predictions
                WHERE user_id = ? AND substr(created_at, 1, 10) >= ?
            )
            GROUP BY day, emotion ORDER BY day""",
            (user["id"], start_date),
        ).fetchall()
    by_day = {}
    for row in rows:
        by_day.setdefault(row["day"], {})[row["emotion"]] = row["count"]
    return {
        "days": days,
        "start_date": start_date,
        "end_date": today_utc().isoformat(),
        "labels": EMOTIONS,
        "records": [{"date": day, "counts": counts} for day, counts in sorted(by_day.items())],
    }


