def utc_now():
    return datetime.now(timezone.utc)


def now_text():
    return utc_now().strftime("%Y-%m-%d %H:%M:%S")


def today_utc() -> date:
    return utc_now().date()


def hash_password(password: str, salt: str) -> str:
    return hashlib.pbkdf2_hmac(
        "sha256", password.encode("utf-8"), bytes.fromhex(salt), 240_000
    ).hex()


def hash_pin(pin: str, salt: str) -> str:
    return hashlib.pbkdf2_hmac(
        "sha256", pin.encode("utf-8"), bytes.fromhex(salt), 240_000
    ).hex()


def issue_token(user_id: int) -> str:
    token = secrets.token_urlsafe(32)
    digest = hashlib.sha256(token.encode("utf-8")).hexdigest()
    with database() as connection:
        connection.execute(
            "INSERT INTO sessions(token_hash, user_id, expires_at) VALUES (?, ?, ?)",
            (digest, user_id, int(time.time()) + TOKEN_LIFETIME_SECONDS),
        )
    return token


def public_user(row):
    return {
        "id": row["id"],
        "username": row["username"],
        "display_name": row["display_name"] or row["username"],
        "is_guest": bool(row["is_guest"]),
    }


def extract_token(authorization):
    if not authorization or not authorization.lower().startswith("bearer "):
        raise HTTPException(status_code=401, detail="Sign in to continue.")
    token = authorization[7:].strip()
    if not token:
        raise HTTPException(status_code=401, detail="Your session is invalid.")
    return token


def current_user(authorization: Annotated[str | None, Header()] = None):
    token_hash = hashlib.sha256(extract_token(authorization).encode("utf-8")).hexdigest()
    with database() as connection:
        row = connection.execute(
            """SELECT u.* FROM sessions s JOIN users u ON u.id = s.user_id
            WHERE s.token_hash = ? AND s.expires_at > ?""",
            (token_hash, int(time.time())),
        ).fetchone()
    if row is None:
        raise HTTPException(status_code=401, detail="Your session has expired. Sign in again.")
    return public_user(row)


User = Annotated[dict, Depends(current_user)]


def issue_auth_for_row(row):
    return {"access_token": issue_token(row["id"]), **public_user(row)}


