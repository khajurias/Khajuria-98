@lru_cache(maxsize=1)
def load_emotion_model():
    if MODEL_PATH.exists():
        model = _validate_model(joblib.load(MODEL_PATH))
        if set(getattr(model, "classes_", [])) == set(EMOTIONS):
            return model
    model = train_emotion_model()
    MODEL_PATH.parent.mkdir(parents=True, exist_ok=True)
    joblib.dump(model, MODEL_PATH)
    return _validate_model(model)


def load_training_data():
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    base_url = GOEMOTIONS_BASE_URL
    splits = {}
    for split in ("train", "dev", "test"):
        texts = []
        targets = []
        path = DATA_DIR / f"goemotions_{split}.tsv"
        if not path.exists():
            url = f"{base_url}/{split}.tsv"
            try:
                with urllib.request.urlopen(url, timeout=30) as response:
                    path.write_bytes(response.read())
            except (OSError, urllib.error.URLError) as error:
                raise RuntimeError(
                    f"Could not download {split} dataset from {url}: {error}"
                ) from error
        with path.open("r", encoding="utf-8", newline="") as source:
            reader = csv.reader(source, delimiter="\t")
            for row in reader:
                if len(row) < 2 or not row[0].strip():
                    continue
                try:
                    labels = {
                        GOEMOTIONS_TO_EMOTION[GOEMOTIONS_LABELS[int(label_id)]]
                        for label_id in row[1].split(",")
                        if 0 <= int(label_id) < len(GOEMOTIONS_LABELS)
                        and GOEMOTIONS_LABELS[int(label_id)] in GOEMOTIONS_TO_EMOTION
                    }
                except ValueError:
                    continue
                if len(labels) == 1:
                    cleaned_text = re.sub(r"\s+", " ", row[0]).strip()
                    cleaned_text = re.sub(r"\[[A-Z][A-Z_]*\]", "", cleaned_text).strip()
                    if cleaned_text:
                        texts.append(cleaned_text)
                        targets.append(labels.pop())
        splits[split] = (texts, targets)
    training_texts = splits["train"][0] + splits["dev"][0]
    training_targets = splits["train"][1] + splits["dev"][1]
    if not training_texts or set(training_targets) != set(EMOTIONS):
        raise ValueError(
            "The GoEmotions train/dev data did not provide usable examples for all "
            "eight InnerEcho emotion categories."
        )
    return training_texts, training_targets, splits["test"]


def normalize_prediction_text(text):
    """Normalize text consistently for training and inference."""
    text = text.lower()
    text = re.sub(r"https?://\S+|www\.\S+", " ", text)
    text = re.sub(r"\b\d{3,}(?:\s*[-.]?\s*)?\b", " ", text)
    text = re.sub(r"\[[A-Z][A-Z_]*\]", " ", text)
    text = re.sub(r"[^\w'!?.,;:()$%\s]", " ", text)
    return re.sub(r"\s+", " ", text).strip()


def train_emotion_model():
    from sklearn.feature_extraction.text import TfidfVectorizer
    from sklearn.linear_model import LogisticRegression
    from sklearn.pipeline import make_pipeline
    from sklearn.pipeline import FeatureUnion

    texts, targets, (test_texts, test_targets) = load_training_data()
    texts = [normalize_prediction_text(text) for text in texts]
    test_texts = [normalize_prediction_text(text) for text in test_texts]

    features = FeatureUnion(
        [
            (
                "word_tfidf",
                TfidfVectorizer(
                    max_features=50_000,
                    min_df=2,
                    ngram_range=(1, 2),
                    strip_accents="unicode",
                    sublinear_tf=True,
                ),
            ),
            (
                "char_tfidf",
                TfidfVectorizer(
                    analyzer="char_wb",
                    max_features=25_000,
                    min_df=2,
                    ngram_range=(3, 5),
                    sublinear_tf=True,
                ),
            ),
        ]
    )
    model = make_pipeline(
        features,
        LogisticRegression(
            C=2.0,
            max_iter=500,
            solver="lbfgs",
            class_weight="balanced",
            random_state=42,
        ),
    )
    model.fit(texts, targets)
    if test_texts:
        from sklearn.metrics import classification_report, f1_score, accuracy_score

        predictions = model.predict(test_texts)
        print(f"GoEmotions test accuracy: {accuracy_score(test_targets, predictions):.3f}")
        print(f"GoEmotions test macro-F1: {f1_score(test_targets, predictions, average='macro'):.3f}")
        print(
            classification_report(
                test_targets, predictions, labels=EMOTIONS, zero_division=0
            )
        )
    return model


def _validate_model(model):
    if not hasattr(model, "predict_proba") or not hasattr(model, "classes_"):
        raise ValueError("The configured model must support predict_proba.")
    return model


def predict_emotion(text):
    try:
        model = load_emotion_model()
    except (OSError, ValueError, ImportError, RuntimeError) as error:
        raise HTTPException(status_code=503, detail=f"Emotion model unavailable: {error}") from error
    probabilities = model.predict_proba([normalize_prediction_text(text)])[0]
    scores = {
        str(label): float(probability) * 100
        for label, probability in zip(model.classes_, probabilities)
    }
    best_emotion = max(scores, key=scores.get)
    emotion = best_emotion
    if scores[best_emotion] / 100 < UNCERTAIN_THRESHOLD:
        emotion = "uncertain"
    scores.setdefault("uncertain", 0.0)
    return emotion, {label: round(score, 2) for label, score in scores.items()}


