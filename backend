@app.post("/game/guess")
def submit_game_guess(payload: GuessRequest, user: User):
    if payload.guess not in EMOTIONS:
        raise HTTPException(status_code=422, detail="Choose a listed emotion.")
    with database() as connection:
        row = connection.execute(
            """SELECT answer, is_answered FROM game_questions
            WHERE game_id = ? AND user_id = ?""",
            (payload.game_id, user["id"]),
        ).fetchone()
        if row is None:
            raise HTTPException(status_code=404, detail="Question not found. Start another round.")
        if row["is_answered"]:
            raise HTTPException(status_code=409, detail="This question was already answered.")
        correct = payload.guess == row["answer"]
        connection.execute(
            "UPDATE game_questions SET is_answered = 1 WHERE game_id = ?", (payload.game_id,)
        )
        connection.execute("INSERT OR IGNORE INTO game_scores(user_id) VALUES (?)", (user["id"],))
        old_score = connection.execute(
            "SELECT * FROM game_scores WHERE user_id = ?", (user["id"],)
        ).fetchone()
        streak = old_score["streak"] + 1 if correct else 0
        connection.execute(
            """UPDATE game_scores SET score = score + ?, rounds = rounds + 1,
            correct_answers = correct_answers + ?, streak = ?,
            best_streak = MAX(best_streak, ?) WHERE user_id = ?""",
            (10 if correct else 0, int(correct), streak, streak, user["id"]),
        )
    return {"correct": correct, "answer": row["answer"]}


